# ===== 复制本文件为 .env 并填入真实值，.env 不会被提交到 Git =====

# ===== 应用配置 =====
APP_PORT=18080
HOST=0.0.0.0
PORT=18080
PROJECT_ROOT=/app

# ===== MySQL 配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=enterprise_kg

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ===== Milvus 配置 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_EXTERNAL_PORT=19530
MILVUS_DATABASE_NAME=enterprise
MILVUS_COLLECTION_NAME=enterprise_rag

# ===== LLM 配置（在阿里云百炼控制台申请后填入）=====
DASHSCOPE_API_KEY=sk-请填写你的DashScope密钥
LLM_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 检索参数 =====
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50
RETRIEVAL_K=3
CANDIDATE_M=2

# ===== 应用配置 =====
VALID_SOURCES=["product", "tech", "hr", "admin"]
CUSTOMER_SERVICE_PHONE=企业客服
